# Configuration for wg21-wiki-mcp.
#
# In production these are supplied as the MCP server's launch `env` block (see
# README). This .env file is only a convenience for local development; values
# are read from the process environment and never printed to logs or output.
#
# The wiki base URL is fixed (https://wiki.isocpp.org) and not configurable.

# --- Bot password (default login path when set) -----------------------------
# Created at Special:BotPasswords; username is "MainAccount@botname".
# Works directly against api.php and is the most robust path for unattended use.
WIKI_BOT_USERNAME=
WIKI_BOT_PASSWORD=

# --- Normal user account (SSO fallback) -------------------------------------
# Your ordinary wiki login. Authenticates headlessly through the SAML SSO flow
# (no browser, no bot-password step). Requires that MFA is NOT enabled.
# Used only if bot credentials are absent or fail to log in.
WIKI_USER_USERNAME=
WIKI_USER_PASSWORD=

# --- Optional tuning ---------------------------------------------------------
# Cache directory (defaults to ~/.isocpp.wiki).
# ISOCPP_WIKI_CACHE_DIR=

# Cache TTLs in seconds (defaults: 604800 = 1 week normal, 3600 = 1 hour during meetings).
# ISOCPP_WIKI_TTL_NORMAL=604800
# ISOCPP_WIKI_TTL_MEETING=3600

# Comma-separated meeting windows to force "meeting mode" (YYYY-MM-DD/YYYY-MM-DD),
# overriding the public-calendar autodetection if needed.
# ISOCPP_WIKI_MEETING_WINDOWS=

# SAML SSO field overrides (only needed when the IdP form uses non-standard names).
# WIKI_SAML_USERNAME_FIELD=
# WIKI_SAML_PASSWORD_FIELD=
# Per-step HTTP timeout in seconds for the SAML flow (default: 30).
# WIKI_SAML_TIMEOUT_S=30

# Legacy wiki.edg.com link hygiene (rewrites embedded discontinued URLs in page text).
# ISOCPP_WIKI_URL_HYGIENE_TIMEOUT_S=12
# ISOCPP_WIKI_URL_REMAP_TTL=604800

# --- Experimental HTTP transport (prototype; default is stdio) ---------------
# See docs/TRANSPORT-EVAL.md. Not for production WAN exposure without hardening.
# WG21_TRANSPORT=stdio
# WG21_HTTP_HOST=127.0.0.1
# WG21_HTTP_PORT=8000
